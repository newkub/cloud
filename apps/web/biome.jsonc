{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"includes": [
			"src/**/*",
			"!src/routeTree.gen.ts",
			"!dist",
			"package.json",
			"tsconfig.json",
			"biome.jsonc"
		]
	},
	"overrides": [
		{
			"includes": ["src/styles/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
