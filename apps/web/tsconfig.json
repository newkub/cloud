{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["vite/client"],
		"paths": {
			"#analytics": ["../../packages/services/analytics/index.ts"],
			"#analytics/*": ["../../packages/services/analytics/*"]
		}
	},
	"include": ["src", "vite.config.ts", "uno.config.ts"]
}
