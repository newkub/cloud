{
	"name": "@wrikka/cloud",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"description": "Wrikka cloud platform monorepo — CI runner, dashboard, CLI, and shared services",
	"packageManager": "bun@1.4.2",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*/*"
		],
		"catalog": {
			"@biomejs/biome": "^2.5.13",
			"@codemirror/lang-markdown": "^6.0.0",
			"@codemirror/state": "^6.0.0",
			"@codemirror/view": "^6.0.0",
			"@tanstack/solid-router": "^1.170.34",
			"@tanstack/solid-table": "^9.2.4",
			"@tsdown/css": "^0.23.0",
			"@types/bun": "^1.4.2",
			"@types/node": "^26.6.1",
			"@vitest/coverage-v8": "^5.0.1",
			"arktype": "^2.2.3",
			"bunup": "^0.16.32",
			"codemirror": "^6.0.2",
			"drizzle-orm": "^0.45.2",
			"effect": "^3.22.2",
			"elysia": "^1.4.30",
			"katex": "^0.18.7",
			"solid-js": "^1.9.15",
			"tsdown": "^0.23.0",
			"typescript": "^7.0.2",
			"unocss": "^66.10.4",
			"uqr": "^0.1.3",
			"vite": "^8.3.0",
			"vitest": "^5.0.1",
			"zod": "^4.6.5"
		}
	},
	"scripts": {
		"dev": "bun --filter @wrikka/cloud-web dev",
		"dev:ci": "bun --filter @wrikka/cloud-ci dev",
		"build": "bun run build:web && bun run build:ci",
		"build:web": "bun --filter @wrikka/cloud-web build",
		"build:ci": "bun --filter @wrikka/cloud-ci build",
		"typecheck": "bun --filter @wrikka/cloud-web typecheck && bun --filter @wrikka/cloud-ci typecheck",
		"typecheck:services": "bun --filter @wrikka/analytics typecheck && bun --filter @wrikka/notification typecheck",
		"check": "bun run typecheck",
		"test": "bun --filter @wrikka/cloud-web test"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	}
}
