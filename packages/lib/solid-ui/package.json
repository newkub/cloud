{
	"name": "@wrikka/solid-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "SolidJS component library and UnoCSS preset for the Wrikka cloud platform",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./registry": {
			"types": "./dist/registry.d.mts",
			"default": "./dist/registry.mjs"
		},
		"./command-palette": {
			"types": "./dist/modules/command-palette/index.d.mts",
			"default": "./dist/modules/command-palette/index.mjs"
		},
		"./preset": {
			"types": "./dist/preset.d.mts",
			"default": "./dist/preset.mjs"
		},
		"./theme": {
			"types": "./dist/theme/index.d.mts",
			"default": "./dist/theme/index.mjs"
		},
		"./styles/*": "./src/styles/*"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@codemirror/lang-markdown": "catalog:",
		"@codemirror/state": "catalog:",
		"@codemirror/view": "catalog:",
		"@tanstack/solid-table": "catalog:",
		"@wrikka/animation": "workspace:*",
		"@wrikka/chart": "workspace:*",
		"@wrikka/hooks": "workspace:*",
		"arktype": "catalog:",
		"codemirror": "catalog:",
		"effect": "catalog:",
		"katex": "catalog:",
		"solid-js": "catalog:",
		"uqr": "catalog:"
	},
	"peerDependencies": {
		"unocss": "catalog:"
	},
	"peerDependenciesMeta": {
		"unocss": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tsdown/css": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"unocss": "catalog:"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/newkub/cloud",
		"directory": "packages/lib/solid-ui"
	}
}
